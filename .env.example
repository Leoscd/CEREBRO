# Copiar a .env y completar. Nunca commitear .env.
SECRET_KEY=cambiame-por-un-valor-largo-y-aleatorio
# En Docker, DATABASE_URL lo arma docker-compose con POSTGRES_PASSWORD.
POSTGRES_PASSWORD=cambiame-tambien
DATABASE_URL=postgresql://gsp:gsp@localhost:5432/gsp
APP_PORT=8000

# Nombre visible de la plataforma
MARCA=Gestor de Proyectos
URL_PUBLICA=http://localhost:8000
TIMEZONE=America/Argentina/Buenos_Aires

# Seguridad
ADMIN_REQUIERE_2FA=0
INVITACION_DIAS=14

# Email (sin SMTP_HOST los correos se guardan en data/correos/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gestor de Proyectos <proyectos@example.com>

# Almacenamiento de archivos (M1)
ALMACEN_DIR=data/archivos
ARCHIVO_MAX_MB=1024

# OpenAI (M1+). Los modelos se eligen por agente.
OPENAI_API_KEY=

# Usá falso para desarrollo sin conexión. La dimensión coincide con vector(384) en Postgres.
EMBEDDINGS_PROVEEDOR=openai
MODELO_EMBEDDINGS=
EMBEDDINGS_DIMENSIONES=384

# Seleccioná el modelo del Documentador; falso ejecuta el guion de prueba local.
AGENTES_PROVEEDOR=openai
MODELO_DOCUMENTADOR=
MODELO_PRESUPUESTOS=
MODELO_OBRA=
OBRA_CONSULTAS_POR_HORA=20

# Dictado en partes diarios. Completá un modelo de transcripción de OpenAI o usá falso local.
TRANSCRIPCION_PROVEEDOR=openai
MODELO_TRANSCRIPCION=

# Límite por consulta (1 a 12) y por persona en toda su empresa.
PRESUPUESTOS_MAX_RONDAS=8
PRESUPUESTOS_CONSULTAS_POR_HORA=20
GOTENBERG_URL=
GOTENBERG_TIMEOUT=60
GOTENBERG_PDF_MAX_MB=64
DXF_MAX_MB=50
